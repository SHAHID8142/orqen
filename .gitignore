# --- Dependencies / build output ---
node_modules
dist
dist-ssr
coverage

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vitest-debug.log*

# --- Environment & secrets (NEVER commit credentials) ---
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12

# --- Databases / local data (future SQLite lives here, never committed) ---
*.sqlite
*.sqlite3
*.db

# --- Rust / Tauri build artifacts (also covered by src-tauri/.gitignore) ---
src-tauri/target/
src-tauri/gen/

# --- Editor directories and files ---
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating system ---
.DS_Store
Thumbs.db
desktop.ini
